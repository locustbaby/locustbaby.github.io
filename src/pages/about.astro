---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About — Locust">
  <Nav />

  <main class="about-page">
    <section class="about-hero">
      <h1 class="about-title">
        <span class="about-line outline-text">ABOUT</span>
      </h1>
    </section>

    <section class="about-content">
      <div class="about-block">
        <h2 class="block-label">Who</h2>
        <p class="block-text">
          An engineer working at the intersection of cloud infrastructure, reliability engineering, and AI.
          Building systems that scale, break, and get rebuilt — better.
        </p>
      </div>

      <div class="about-block">
        <h2 class="block-label">What</h2>
        <p class="block-text">
          This space is where I document learnings, share technical deep-dives,
          and occasionally think out loud about where technology is heading.
        </p>
      </div>

      <div class="about-block">
        <h2 class="block-label">Stack</h2>
        <div class="tech-grid">
          <span class="tech-item">KUBERNETES</span>
          <span class="tech-item">TERRAFORM</span>
          <span class="tech-item">GCP / AWS</span>
          <span class="tech-item">GOLANG</span>
          <span class="tech-item">PYTHON</span>
          <span class="tech-item">PROMETHEUS</span>
          <span class="tech-item">AI AGENTS</span>
        </div>
      </div>

      <div class="about-block">
        <h2 class="block-label">Connect</h2>
        <div class="connect-links">
          <a href="https://github.com/locustbaby" target="_blank" rel="noopener" class="connect-link" data-hover>
            GITHUB &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    function initAboutAnimations() {
      gsap.registerPlugin(ScrollTrigger);

      gsap.from('.about-line', { opacity: 0, y: 100, rotation: 2, duration: 1.2, delay: 0.2, ease: 'power4.out' });

      document.querySelectorAll('.about-block').forEach((block, i) => {
        gsap.from(block, {
          scrollTrigger: { trigger: block, start: 'top 85%' },
          opacity: 0,
          y: 60,
          duration: 1,
          delay: i * 0.1,
          ease: 'power3.out',
        });
      });
    }

    initAboutAnimations();
    document.addEventListener('astro:page-load', () => {
      ScrollTrigger.getAll().forEach(t => t.kill());
      initAboutAnimations();
    });
  </script>
</BaseLayout>

<style>
  .about-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 15rem 5vw 10rem;
    min-height: 100vh;
  }

  .about-hero {
    margin-bottom: 8rem;
  }

  .about-title {
    font-size: clamp(4rem, 15vw, 12rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.8;
  }

  .about-line {
    display: inline-block;
    transform-origin: left bottom;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .about-block {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 4rem;
    align-items: start;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .block-label {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .block-text {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tech-item {
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--text-muted);
    border-radius: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .tech-item:hover {
    border-color: var(--accent);
    color: #000;
    background: var(--accent);
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 255, 65, 0.3);
  }

  .connect-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .connect-link {
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 900;
    color: var(--text);
    text-transform: uppercase;
    transition: color 0.3s, transform 0.3s;
    display: inline-block;
    width: fit-content;
  }

  .connect-link:hover {
    color: var(--accent);
    transform: translateX(20px);
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 10rem 1.5rem 6rem;
    }

    .about-block {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .block-label {
      margin-bottom: 0.5rem;
    }
  }
</style>
