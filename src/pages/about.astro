---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About — Locust">
  <Nav />

  <main class="about-page">
    <section class="about-hero">
      <h1 class="about-title">
        <span class="about-line">About</span>
      </h1>
    </section>

    <section class="about-content">
      <div class="about-block">
        <h2 class="block-label">Who</h2>
        <p class="block-text">
          An engineer working at the intersection of cloud infrastructure, reliability engineering, and AI.
          Building systems that scale, break, and get rebuilt — better.
        </p>
      </div>

      <div class="about-block">
        <h2 class="block-label">What</h2>
        <p class="block-text">
          This space is where I document learnings, share technical deep-dives,
          and occasionally think out loud about where technology is heading.
        </p>
      </div>

      <div class="about-block">
        <h2 class="block-label">Stack</h2>
        <div class="tech-grid">
          <span class="tech-item">Kubernetes</span>
          <span class="tech-item">Terraform</span>
          <span class="tech-item">GCP / AWS</span>
          <span class="tech-item">Go</span>
          <span class="tech-item">Python</span>
          <span class="tech-item">Prometheus</span>
          <span class="tech-item">LLM / Agent</span>
        </div>
      </div>

      <div class="about-block">
        <h2 class="block-label">Connect</h2>
        <div class="connect-links">
          <a href="https://github.com/locustbaby" target="_blank" rel="noopener" class="connect-link" data-hover>
            GitHub &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    gsap.from('.about-line', { opacity: 0, y: 80, duration: 1, delay: 0.3, ease: 'power3.out' });

    document.querySelectorAll('.about-block').forEach((block, i) => {
      gsap.from(block, {
        scrollTrigger: { trigger: block, start: 'top 85%' },
        opacity: 0,
        y: 40,
        duration: 0.8,
        delay: i * 0.1,
        ease: 'power3.out',
      });
    });
  </script>
</BaseLayout>

<style>
  .about-page {
    max-width: 740px;
    margin: 0 auto;
    padding: 10rem 2rem 4rem;
  }

  .about-hero {
    margin-bottom: 6rem;
  }

  .about-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .about-line {
    display: block;
    overflow: hidden;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .about-block {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .block-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    font-weight: 500;
    padding-top: 0.3rem;
  }

  .block-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-item {
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    transition: all 0.3s;
  }

  .tech-item:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .connect-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .connect-link {
    font-size: 1rem;
    color: var(--text-muted);
    transition: color 0.3s;
  }

  .connect-link:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 7rem 1.5rem 4rem;
    }

    .about-block {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
