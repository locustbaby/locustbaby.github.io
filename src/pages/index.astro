---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Locust - Building in the Cloud">
  <Nav />

  <main class="home" id="scroll-container">
    <section class="hero">
      <div class="hero-content">
        <h1 class="hero-title">
          <div class="hero-line" data-speed="0.8">
            <span class="hero-text text-outline">BE WILD!</span>
          </div>
          <div class="hero-line" data-speed="1.2">
            <span class="hero-text">BUILDING</span>
          </div>
          <div class="hero-line" data-speed="0.9">
            <span class="hero-text text-accent">IN THE CLOUD!</span>
          </div>
        </h1>
        <div class="hero-scroll-indicator">
          <div class="scroll-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
          </div>
          <span>SCROLL SMOOTHLY</span>
        </div>
      </div>
    </section>

    <!-- Interactive CSS Widgets Section -->
    <section class="gallery">
      <!-- INFRASTRUCTURE: Stacking Blocks Widget -->
      <div class="gallery-item item-large">
        <div class="interactive-widget widget-infra" data-speed="1.1">
          <div class="infra-grid" id="infra-blocks"></div>
          <div class="gallery-overlay">
            <span class="gallery-label">INFRASTRUCTURE</span>
          </div>
        </div>
      </div>

      <div class="gallery-text-block" data-speed="0.9">
        <h2 class="section-title outline-text">WHAT CAN I DO?</h2>
        <p class="section-desc">Designing highly available systems and pushing the boundaries of cloud-native architecture. <br/>(Click the widgets below!)</p>
      </div>

      <div class="gallery-grid">
        <!-- SRE & OPS: Chaos Engineering Dashboard -->
        <div class="gallery-item item-portrait">
          <div class="interactive-widget widget-sre" data-speed="1.05">
            <div class="sre-dashboard">
              <div class="metrics-row">
                <div class="uptime-box">
                   <div class="uptime-label">SYSTEM UPTIME</div>
                   <div class="uptime-value" id="uptime-val">99.999%</div>
                </div>
                <button class="chaos-btn" id="btn-chaos">CHAOS</button>
              </div>
              <div class="sre-nodes" id="sre-nodes"></div>
            </div>
            <div class="gallery-overlay">
              <span class="gallery-label">SRE</span>
            </div>
          </div>
        </div>
        
        <!-- AI AGENTS: Mechanical Lobster Claw -->
        <div class="gallery-item item-landscape">
          <div class="interactive-widget widget-ai" data-speed="0.95">
            <div class="claw-container">
              <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="lobster-claw" id="lobster-svg">
                <defs>
                   <linearGradient id="lobster-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                     <stop offset="0%" stop-color="#FF6B4A" />
                     <stop offset="100%" stop-color="#D93D1A" />
                   </linearGradient>
                </defs>
                <g class="claw-group">
                  <!-- Lobster Claw Silhouette -->
                  <path d="M60 10 C30 10 15 35 15 55 C15 75 30 95 45 100 L45 110 L55 110 L55 100 C55 100 60 102 65 100 L65 110 L75 110 L75 100 C90 95 105 75 105 55 C105 35 90 10 60 10Z" fill="url(#lobster-gradient)" class="claw-body"></path>
                  <!-- Antenna -->
                  <path d="M45 15 Q35 5 30 8" stroke="#FF6B4A" stroke-width="2" stroke-linecap="round" class="antenna"></path>
                  <path d="M75 15 Q85 5 90 8" stroke="#FF6B4A" stroke-width="2" stroke-linecap="round" class="antenna"></path>
                  <!-- Left Claw -->
                  <path d="M20 45 C5 40 0 50 5 60 C10 70 20 65 25 55 C28 48 25 45 20 45Z" fill="url(#lobster-gradient)" class="claw-left"></path>
                  <!-- Right Claw -->
                  <path d="M100 45 C115 40 120 50 115 60 C110 70 100 65 95 55 C92 48 95 45 100 45Z" fill="url(#lobster-gradient)" class="claw-right"></path>
                  <!-- Eyes -->
                  <circle cx="45" cy="35" r="6" fill="#000" class="eye"></circle>
                  <circle cx="75" cy="35" r="6" fill="#000" class="eye"></circle>
                  <circle cx="46" cy="34" r="2" fill="#fff" class="eye-glow"></circle>
                  <circle cx="76" cy="34" r="2" fill="#fff" class="eye-glow"></circle>
                </g>
              </svg>
            </div>
            <div class="gallery-overlay">
              <span class="gallery-label">AI AGENTS</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Marquee Section -->
    <section class="marquee-section">
      <div class="marquee">
        <div class="marquee-inner">
          <div class="marquee-set">
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/kubernetes/kubernetes-plain.svg" alt="k8s"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/terraform/terraform-original.svg" alt="terraform"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-original-wordmark.svg" alt="aws"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/googlecloud/googlecloud-original.svg" alt="gcp"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/go/go-original.svg" alt="go"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg" alt="docker"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linux/linux-original.svg" alt="linux"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/prometheus/prometheus-original.svg" alt="prometheus"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/grafana/grafana-original.svg" alt="grafana"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nginx/nginx-original.svg" alt="nginx"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/rust/rust-original.svg" alt="rust"/></div>
          </div>
          <!-- Duplicate for seamless loop -->
          <div class="marquee-set">
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/kubernetes/kubernetes-plain.svg" alt="k8s"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/terraform/terraform-original.svg" alt="terraform"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-original-wordmark.svg" alt="aws"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/googlecloud/googlecloud-original.svg" alt="gcp"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/go/go-original.svg" alt="go"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg" alt="docker"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linux/linux-original.svg" alt="linux"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/prometheus/prometheus-original.svg" alt="prometheus"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/grafana/grafana-original.svg" alt="grafana"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nginx/nginx-original.svg" alt="nginx"/></div>
            <div class="tech-item"><img class="tech-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/rust/rust-original.svg" alt="rust"/></div>
          </div>
        </div>
      </div>
    </section>

    <div class="spacer"></div>
  </main>

  <Footer />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    function initHomeAnimations() {
      gsap.registerPlugin(ScrollTrigger);

      // Hero Entry Animation (Drop down effect)
      const tl = gsap.timeline();
      
      tl.fromTo('.hero-text', 
        { y: '-150%' },
        { y: '0%', duration: 1.5, stagger: 0.15, ease: 'power4.out', delay: 0.2 }
      )
      .fromTo('.hero-scroll-indicator', 
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 1 }, 
        "-=1"
      );

      // Scroll Parallax - only hero lines, skip widgets (avoid jitter)
      const heroLines = document.querySelectorAll('.hero [data-speed]');
      heroLines.forEach((el) => {
        const speed = parseFloat(el.getAttribute('data-speed') || '1');
        const yOffset = (1 - speed) * 80;
        gsap.to(el, {
          y: yOffset + 'vh',
          ease: 'none',
          scrollTrigger: {
            trigger: '.hero',
            start: 'top top',
            end: 'bottom top',
            scrub: 1,
            invalidateOnRefresh: true
          }
        });
      });

      // Section text parallax
      const sectionText = document.querySelector('.gallery-text-block');
      if (sectionText) {
        gsap.to(sectionText, {
          y: '-5vh',
          ease: 'none',
          scrollTrigger: {
            trigger: sectionText,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1
          }
        });
      }

      // Widget reveal - staggered batch for smoothness
      ScrollTrigger.batch('.interactive-widget', {
        onEnter: (els) => {
          gsap.fromTo(els,
            { clipPath: 'polygon(0 100%, 100% 100%, 100% 100%, 0 100%)', opacity: 0 },
            { clipPath: 'polygon(0 0, 100% 0, 100% 100%, 0 100%)', opacity: 1, duration: 0.8, ease: 'power3.out', stagger: 0.15 }
          );
        },
        start: 'top 92%',
        once: true
      });

      // Interactive Logic for Widgets
      
      // Infra Blocks Match-3 Game
      const infraContainer = document.getElementById('infra-blocks');
      if (infraContainer && !infraContainer.dataset.init) {
        infraContainer.dataset.init = 'true';
        infraContainer.innerHTML = '';
        const C = 6, R = 5;
        const types = ['infra-db', 'infra-node', 'infra-pod', 'infra-net'];
        
        const getIcon = (type) => {
          if (type === 'infra-db') return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>`;
          if (type === 'infra-node') return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>`;
          if (type === 'infra-pod') return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>`;
          return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`;
        };

        let blocks = [];

        for (let c = 0; c < C; c++) {
          blocks[c] = [];
          for (let r = 0; r < R; r++) {
            blocks[c][r] = createBlock(c, r);
          }
        }

        function createBlock(c, r) {
          const type = types[Math.floor(Math.random() * types.length)];
          const el = document.createElement('div');
          el.className = `infra-block ${type}`;
          el.dataset.type = type;
          el.innerHTML = getIcon(type);
          
          el.style.left = `${(c / C) * 100}%`;
          el.style.top = `${(r / R) * 100}%`;
          el.style.width = `${100 / C}%`;
          el.style.height = `${100 / R}%`;
          
          el.onclick = (e) => {
            e.stopPropagation();
            for (let currC = 0; currC < C; currC++) {
              for (let currR = 0; currR < R; currR++) {
                if (blocks[currC][currR] === el) popBlocks(currC, currR);
              }
            }
          };
          
          infraContainer.appendChild(el);
          return el;
        }

        function popBlocks(clickC, clickR) {
          const type = blocks[clickC][clickR].dataset.type;
          let toPop = [];
          const visited = new Set();
          
          const dfs = (c, r) => {
            if (c < 0 || c >= C || r < 0 || r >= R) return;
            const key = `${c},${r}`;
            if (visited.has(key)) return;
            visited.add(key);
            
            if (blocks[c][r] && blocks[c][r].dataset.type === type) {
              toPop.push({c, r});
              dfs(c+1, r); dfs(c-1, r); dfs(c, r+1); dfs(c, r-1);
            }
          };
          
          dfs(clickC, clickR);
          
          // Pop minimum 2 connected
          if (toPop.length >= 2) {
            toPop.forEach(p => {
              const el = blocks[p.c][p.r];
              el.style.transform = 'scale(0)';
              setTimeout(() => el.remove(), 200);
              blocks[p.c][p.r] = null;
            });
            
            setTimeout(() => {
              for (let c = 0; c < C; c++) {
                let colItems = blocks[c].filter(el => el !== null);
                let missing = R - colItems.length;
                
                let newItems = [];
                for (let i = 0; i < missing; i++) {
                  // Span out of bounds top
                  const el = createBlock(c, -missing + i);
                  newItems.push(el);
                }
                
                blocks[c] = [...newItems, ...colItems];
                
                blocks[c].forEach((el, newR) => {
                  el.style.top = `${(newR / R) * 100}%`;
                });
              }
            }, 50);
          }
        }
      }

      // SRE Dashboard Minigame
      const sreNodes = document.getElementById('sre-nodes');
      const btnChaos = document.getElementById('btn-chaos');
      const uptimeVal = document.getElementById('uptime-val');
      
      if (sreNodes && !sreNodes.dataset.init) {
        sreNodes.dataset.init = 'true';
        let activeIncidents = 0;
        
        for(let i=0; i<16; i++) {
          const node = document.createElement('div');
          node.className = 'sre-node healthy';
          node.onclick = (e) => {
             e.stopPropagation();
             if (node.classList.contains('down')) {
                node.classList.remove('down');
                node.classList.add('healthy');
                activeIncidents--;
                updateUptime();
             }
          };
          sreNodes.appendChild(node);
        }
        
        function updateUptime() {
          if(activeIncidents <= 0) {
             activeIncidents = 0;
             uptimeVal.innerText = '99.999%';
             uptimeVal.style.color = '#00ff41';
          } else {
             const health = (100 - (activeIncidents * 4.321)).toFixed(3);
             uptimeVal.innerText = `${health}%`;
             uptimeVal.style.color = '#ff2d55';
          }
        }

        if (btnChaos) {
          btnChaos.onclick = (e) => {
            e.stopPropagation();
            const nodes = Array.from(sreNodes.children);
            for(let i=0; i<3; i++){
               const r = Math.floor(Math.random() * nodes.length);
               if(nodes[r].classList.contains('healthy')) {
                  nodes[r].classList.remove('healthy');
                  nodes[r].classList.add('down');
                  activeIncidents++;
               }
            }
            updateUptime();
          };
        }
      }

      // AI Lobster Claw Interactive Logic
      const clawGroup = document.querySelector('.claw-group');
      const widgetAi = document.querySelector('.widget-ai');
      let isPinching = false;
      
      if (clawGroup && widgetAi) {
        // Toggle pinch on click
        widgetAi.addEventListener('click', () => {
          isPinching = !isPinching;
          clawGroup.classList.toggle('pinched', isPinching);
          
          // Electrical discharge effect
          const svgEl = document.getElementById('lobster-svg');
          if (svgEl) {
             svgEl.classList.add('shocked');
             setTimeout(() => svgEl.classList.remove('shocked'), 300);
          }
        });
        
        // Follow mouse slightly
        widgetAi.addEventListener('mousemove', (e) => {
          const mouseEvent = e;
          const rect = widgetAi.getBoundingClientRect();
          const x = (mouseEvent.clientX - rect.left) / rect.width - 0.5;
          const y = (mouseEvent.clientY - rect.top) / rect.height - 0.5;
          
          gsap.to(clawGroup, {
            rotation: x * 20,
            x: x * 10,
            y: y * 10,
            transformOrigin: '50% 80%',
            duration: 0.5,
            ease: 'power2.out'
          });
          
          gsap.to('.eye', { x: x * 4, y: y * 4, duration: 0.2 });
          gsap.to('.eye-glow', { x: x * 6, y: y * 6, duration: 0.2 });
        });
        
        widgetAi.addEventListener('mouseleave', () => {
          gsap.to([clawGroup, '.eye', '.eye-glow'], { 
            rotation: 0, x: 0, y: 0, duration: 0.5, ease: 'power2.out' 
          });
        });
      }
    }

    // Run on init and after ViewTransitions
    initHomeAnimations();
    document.addEventListener('astro:page-load', () => {
      // Clear old ScrollTriggers
      ScrollTrigger.getAll().forEach(t => t.kill());
      initHomeAnimations();
    });
  </script>
</BaseLayout>

<style>
  .home {
    background-color: var(--bg);
    min-height: 100vh;
  }

  /* Hero Section */
  .hero {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 5vw;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    width: 100%;
    z-index: 10;
  }

  .hero-title {
    font-size: clamp(3rem, 12vw, 15rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .hero-line {
    overflow: hidden;
    margin-bottom: -1vw;
    padding-bottom: 1vw; /* Buffer for letters like G */
  }

  .hero-text {
    display: inline-block;
    transform-origin: left bottom;
  }

  .text-outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--text);
  }

  .text-accent {
    color: var(--accent);
    text-shadow: 0 0 40px rgba(0, 255, 65, 0.3);
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .scroll-icon svg {
    width: 24px;
    height: 24px;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
  }

  /* Interactive Widgets */
  .gallery {
    padding: 10vw 5vw;
    display: flex;
    flex-direction: column;
    gap: 10vw;
  }

  .interactive-widget {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    opacity: 0;
    background: #111;
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.5s;
    will-change: transform, clip-path, opacity;
  }
  
  .interactive-widget:hover {
    border-color: var(--accent);
  }

  .gallery-overlay {
    position: absolute;
    top: 2rem;
    left: 2rem;
    pointer-events: none;
    z-index: 10;
  }

  .gallery-label {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 900;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.5rem 1rem;
    background: transparent;
    backdrop-filter: none;
    border: none;
    border-left: 4px solid var(--accent);
    transition: color 0.3s, border-color 0.3s;
  }

  .interactive-widget:hover .gallery-label {
    color: var(--accent);
    text-shadow: 0 0 20px rgba(0, 255, 65, 0.3);
  }

  /* Infra Widget: Match-3 Grid */
  .widget-infra {
    flex-direction: column;
  }
  
  .infra-grid {
    position: relative;
    width: 90%;
    max-width: 450px;
    height: 60%;
    overflow: hidden;
  }
  
  :global(.infra-block) {
    position: absolute;
    padding: 0.8vw;
    box-sizing: border-box;
    cursor: pointer;
    transition: top 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), 
                left 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), 
                transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  :global(.infra-block svg) {
    width: 100%;
    height: 100%;
    stroke: var(--text-muted);
    transition: all 0.3s;
    opacity: 0.6;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 15%;
  }

  :global(.infra-block:hover svg) {
    opacity: 1;
    transform: scale(1.1);
  }
  
  :global(.infra-block:active) {
    transform: scale(0.8);
  }

  :global(.infra-db svg) { stroke: #00ff41; }
  :global(.infra-node svg) { stroke: #00ffff; }
  :global(.infra-pod svg) { stroke: #ff00ff; }
  :global(.infra-net svg) { stroke: #ffff00; }

  :global(.infra-block:hover.infra-db svg) { filter: drop-shadow(0 0 10px #00ff41); border: 1px solid #00ff41; background: rgba(0,255,65,0.1); }
  :global(.infra-block:hover.infra-node svg) { filter: drop-shadow(0 0 10px #00ffff); border: 1px solid #00ffff; background: rgba(0,255,255,0.1); }
