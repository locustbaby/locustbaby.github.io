---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { categories } from '../lib/categories';

const posts = await getCollection('blog');
const categoryCounts = categories.map(cat => ({
  ...cat,
  count: posts.filter(p => p.data.category === cat.slug).length,
}));
---

<BaseLayout title="Locust">
  <Nav />

  <canvas id="hero-canvas"></canvas>

  <main class="home">
    <section class="hero">
      <div class="hero-content">
        <div class="hero-label">
          <span class="hero-label-line"></span>
          <span class="hero-label-text">WELCOME</span>
        </div>
        <h1 class="hero-title">
          <span class="hero-line" data-line="1">Building</span>
          <span class="hero-line" data-line="2">in the</span>
          <span class="hero-line hero-highlight" data-line="3">Cloud.</span>
        </h1>
        <p class="hero-sub">
          Cloud infrastructure, SRE practices, AI agents, and everything in between.
        </p>
        <div class="hero-scroll">
          <span class="scroll-text">Scroll</span>
          <div class="scroll-line"></div>
        </div>
      </div>
    </section>

    <section class="categories" id="categories">
      <div class="section-header">
        <h2 class="section-title">Explore</h2>
        <p class="section-sub">Dive into different dimensions</p>
      </div>
      <div class="categories-grid">
        {categoryCounts.map((cat, i) => (
          <CategoryCard
            name={cat.name}
            slug={cat.slug}
            description={cat.description}
            color={cat.color}
            count={cat.count}
            index={i}
          />
        ))}
      </div>
    </section>

    <section class="recent">
      <div class="section-header">
        <h2 class="section-title">Recent</h2>
        <a href="/blog" class="section-link" data-hover>View all &rarr;</a>
      </div>
      <div class="recent-list">
        {posts
          .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
          .slice(0, 5)
          .map((post, i) => {
            const cat = categories.find(c => c.slug === post.data.category);
            return (
              <a href={`/blog/${post.id}`} class="recent-item" data-hover style={`--ri: ${i}; --rc: ${cat?.color ?? '#646cff'}`}>
                <span class="recent-category">{cat?.name}</span>
                <span class="recent-title">{post.data.title}</span>
                <span class="recent-date">{post.data.date}</span>
              </a>
            );
          })}
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { initScene } from '../scripts/scene';

    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (canvas) {
      initScene(canvas, 'default');
    }

    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    gsap.from('.hero-label', { opacity: 0, x: -30, duration: 1, delay: 0.2, ease: 'power3.out' });
    gsap.from('.hero-line', { opacity: 0, y: 80, duration: 1, stagger: 0.15, delay: 0.4, ease: 'power3.out' });
    gsap.from('.hero-sub', { opacity: 0, y: 20, duration: 1, delay: 1, ease: 'power3.out' });
    gsap.from('.hero-scroll', { opacity: 0, duration: 1, delay: 1.5, ease: 'power3.out' });

    gsap.from('.section-header', {
      scrollTrigger: { trigger: '.categories', start: 'top 80%' },
      opacity: 0,
      y: 40,
      duration: 0.8,
      ease: 'power3.out',
    });

    gsap.from('.recent .section-header', {
      scrollTrigger: { trigger: '.recent', start: 'top 80%' },
      opacity: 0,
      y: 40,
      duration: 0.8,
      ease: 'power3.out',
    });

    document.querySelectorAll('.recent-item').forEach((item, i) => {
      gsap.from(item, {
        scrollTrigger: { trigger: item, start: 'top 90%' },
        opacity: 0,
        x: -30,
        duration: 0.6,
        delay: i * 0.05,
        ease: 'power3.out',
      });
    });
  </script>
</BaseLayout>

<style>
  #hero-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .home {
    position: relative;
    z-index: 1;
  }

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 3rem;
  }

  .hero-content {
    max-width: 900px;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hero-label-line {
    width: 40px;
    height: 1px;
    background: var(--accent);
  }

  .hero-label-text {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--accent);
    font-weight: 500;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero-line {
    display: block;
    overflow: hidden;
  }

  .hero-highlight {
    background: linear-gradient(135deg, var(--accent), #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    margin-top: 2rem;
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 500px;
    line-height: 1.7;
  }

  .hero-scroll {
    position: absolute;
    bottom: 3rem;
    left: 3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .scroll-text {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }

  .scroll-line {
    width: 40px;
    height: 1px;
    background: var(--text-muted);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { transform: translateX(-100%); }
    50% { transform: translateX(100%); }
  }

  .categories,
  .recent {
    padding: 6rem 3rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .section-sub {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .section-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.3s;
  }

  .section-link:hover {
    color: var(--accent);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
  }

  .recent-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .recent-item:hover {
    padding-left: 1rem;
  }

  .recent-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rc);
    font-weight: 600;
  }

  .recent-title {
    font-size: 1.125rem;
    font-weight: 500;
    transition: color 0.3s;
  }

  .recent-item:hover .recent-title {
    color: var(--rc);
  }

  .recent-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  :global(.cursor-follower) {
    position: fixed;
    width: 32px;
    height: 32px;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transition: width 0.4s, height 0.4s, border-color 0.4s;
  }

  :global(.follower-hover) {
    width: 48px !important;
    height: 48px !important;
    border-color: var(--accent) !important;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 0 1.5rem;
    }

    .categories,
    .recent {
      padding: 4rem 1.5rem;
    }

    .recent-item {
      grid-template-columns: 1fr auto;
    }

    .recent-category {
      display: none;
    }

    :global(.cursor-follower) {
      display: none;
    }
  }
</style>
