---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<nav class="nav">
  <a href="/" class="nav-logo" data-hover>
    <span class="logo-text">L</span>
  </a>
  <div class="nav-links">
    {links.map(link => (
      <a
        href={link.href}
        class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
        data-hover
      >
        <span class="nav-link-text">{link.label}</span>
        <span class="nav-link-line"></span>
      </a>
    ))}
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 3rem;
    backdrop-filter: blur(12px);
    background: rgba(245, 245, 247, 0.8);
  }

  .nav-logo {
    font-family: var(--font-main);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .logo-text {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-logo:hover .logo-text {
    transform: scale(1.2) rotate(-5deg);
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .nav-link {
    position: relative;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0;
    overflow: hidden;
  }

  .nav-link-text {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover .nav-link-text {
    transform: translateY(-100%);
  }

  .nav-link::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    transition: top 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover::after {
    top: 0;
  }

  .nav-link-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover .nav-link-line,
  .nav-link.active .nav-link-line {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 768px) {
    .nav {
      padding: 1rem 1.5rem;
    }
    .nav-links {
      gap: 1.5rem;
    }
  }
</style>
